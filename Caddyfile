# On-demand certificates for the dedicated panel domains
# (admin.<domain> and host.<domain>): the app approves exactly those
# names at /tls-allowed, so no other name pointed at this server can
# ever mint a certificate.
{
	on_demand_tls {
		ask http://127.0.0.1:{$HTTP_PORT}/tls-allowed
	}
}

# Extra sites served by this Caddy instance (other apps sharing the same
# host drop their own .caddy site files in the mounted sites folder; the
# glob is harmless when the folder is empty).
import /etc/caddy/sites/*.caddy

# HLS offload: while a show is live, every viewer fetches the playlist
# and a segment every second - serving those straight from disk keeps
# the app process out of the per-viewer path entirely. The file matcher
# only fires when the file actually exists under the read-only mount,
# so a missing mount or a finished show falls through to the app
# unchanged. The filename whitelist mirrors the app's own route.
(hls_offload) {
	# The playlist grows while live - never cache it
	@hlsplaylist {
		path_regexp hpl ^/live/([a-zA-Z0-9_-]{4,32})/media/live\.m3u8$
		file {
			root /srv/appdata/live
			try_files /{re.hpl.1}/live.m3u8
		}
	}
	handle @hlsplaylist {
		root * /srv/appdata/live
		rewrite * {file_match.relative}
		header Cache-Control "no-store"
		file_server
	}
	# Finished segments never change - a short cache keeps viewers cheap
	@hlssegment {
		path_regexp hseg ^/live/([a-zA-Z0-9_-]{4,32})/media/(seg-\d+-\d+\.m4s|init-\d+\.mp4)$
		file {
			root /srv/appdata/live
			try_files /{re.hseg.1}/{re.hseg.2}
		}
	}
	handle @hlssegment {
		root * /srv/appdata/live
		rewrite * {file_match.relative}
		header Cache-Control "public, max-age=60"
		file_server
	}
}

{$DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	import hls_offload
	reverse_proxy 127.0.0.1:{$HTTP_PORT}
}

# The dedicated panel domains (admin.<domain> for the fleet panel,
# host.<domain> for host dashboards) need no configuration: point their
# DNS here and this catch-all serves them, fetching each certificate on
# demand - the app's /tls-allowed allowlist (derived from DOMAIN, plus
# any explicit ADMIN_DOMAIN/HOST_DOMAIN) is the gate. The app sends each
# domain's root to its own login.
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	import hls_offload
	reverse_proxy 127.0.0.1:{$HTTP_PORT}
}

# Optional old domain forwarding to the real one so old links keep
# working; harmless no-op when LEGACY_DOMAIN is unset
{$LEGACY_DOMAIN::65534} {
	redir https://{$DOMAIN}{uri} permanent
}
