# On-demand certificates for the dashboard's own domain
# (host.<domain>): the app approves exactly that name at /tls-allowed,
# so no other name pointed at this server can ever mint a certificate.
{
	on_demand_tls {
		ask http://127.0.0.1:{$HTTP_PORT}/tls-allowed
	}
}

# Extra sites served by this Caddy instance (other apps sharing the same
# host drop their own .caddy site files in the mounted sites folder; the
# glob is harmless when the folder is empty).
import /etc/caddy/sites/*.caddy

{$DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy 127.0.0.1:{$HTTP_PORT}
}

# The dashboard's own domain (host.<domain>) needs no configuration:
# point its DNS here and this catch-all serves it, fetching the
# certificate on demand - the app's /tls-allowed allowlist (derived from
# DOMAIN, plus any explicit HOST_DOMAIN) is the gate.
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy 127.0.0.1:{$HTTP_PORT}
}

# Optional old domain forwarding to the real one so old links keep
# working; harmless no-op when LEGACY_DOMAIN is unset
{$LEGACY_DOMAIN::65534} {
	redir https://{$DOMAIN}{uri} permanent
}
