# FOSS Studio configuration
# Copy to .env and fill in. Never commit .env.

# The public domain the studio runs at
DOMAIN=studio.example.com

# Public IPv4 of this machine: the media engine gives it to every guest as
# the address to send their audio and video to, so a wrong one means a room
# that opens and stays silent. Find it with: curl -4 https://api.ipify.org
# Leave it empty only if the public address is on this machine's own
# interface, where the engine can work it out. Behind a home router it is
# the router's address, and the UDP ports have to be forwarded here.
# Under Docker it matters twice over: the containers sit on a bridge
# network and can see only their own private addresses, so this is the
# address the media engine and the TURN relay hand out to guests.
PUBLIC_IP=

# Port the studio answers on, published host:container with the same
# number on both sides (APP_BIND below decides who may reach it)
HTTP_PORT=3000

# The ports published for media, one-to-one, host and container alike.
# They are few on purpose: mediasoup multiplexes every connection over
# them, so four carry a full room, and every published port costs Docker
# a proxy process. Move the range if several studios share a host.
#RTC_MIN_PORT=40000
#RTC_MAX_PORT=40003

# The same for the TURN relay's range. Thirty ports: a full room is
# twenty-four relayed connections at the very worst, and this leaves
# some over.
#TURN_MIN_PORT=49160
#TURN_MAX_PORT=49189

# Two different things decide who can reach the web port, and they are
# easy to confuse.
#
# BIND_HOST is the address the app listens on INSIDE its container. The
# image sets it to 0.0.0.0 and it should stay there: a published port
# with the app on loopback reaches nothing. (Run the app straight from
# Node with no container and it defaults to 127.0.0.1 instead.)
#BIND_HOST=0.0.0.0
#
# APP_BIND is the host side of the port mapping, and that is what really
# limits exposure. Left unset the web port answers anything that can
# route here, so a management panel can show you a link. Set it to
# 127.0.0.1 once a proxy on this machine is in front of the app, or to a
# Tailscale address for a tailnet-only studio.
#APP_BIND=127.0.0.1

# Optional: hostname or IP guests use to reach the TURN relay (defaults to
# DOMAIN). Set this if DOMAIN is behind Cloudflare (proxied DNS or a
# tunnel) - relay traffic on port 3478 must reach this server directly,
# so use an unproxied hostname or the raw server IP here.
#TURN_HOST=

# Initial host login password — change it from the dashboard after first login
HOST_PASSWORD=

# Random secret for session cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=

# Shared secret between the app and the TURN relay (generate with: openssl rand -hex 32)
TURN_SECRET=

# Optional: an old domain that should forward to DOMAIN (leave unset if none)
#LEGACY_DOMAIN=old.example.com

# Dedicated panel domains work with no configuration: point the DNS of
# admin.<your-domain> and host.<your-domain> at this server and each
# leads straight to its own login, certificates fetched on demand.
# These overrides exist only for names that don't follow that pattern.
#ADMIN_DOMAIN=fleet.example.net
#HOST_DOMAIN=studio-login.example.net

# Optional: folder of extra .caddy site files served by the bundled Caddy,
# for other apps sharing this host's ports 80/443 (leave unset if none)
#CADDY_SITES_PATH=/opt/caddy/sites

# Optional: folder of static web roots for those extra sites, mounted
# read-only at /srv/www inside Caddy - a site file can then serve files
# with "root * /srv/www/<name>". Point it OUTSIDE this app's folder
# (releases are replaced on every deploy), e.g. next to the sites path.
#CADDY_WWW_PATH=/opt/caddy/www
